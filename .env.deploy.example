# Copy to .env.deploy, then: set -a; source .env.deploy; set +a
# These are resource names, not secret credentials.
GCP_PROJECT_ID=mon-projet-gcp
GCP_REGION=europe-west9
GCP_SERVICE=mon-projet
GCP_ARTIFACT_REPOSITORY=apps
GCP_DATA_BUCKET=mon-projet-gcp-pocketbase
GCP_RUNTIME_SERVICE_ACCOUNT=pocketbase-runtime@mon-projet-gcp.iam.gserviceaccount.com
